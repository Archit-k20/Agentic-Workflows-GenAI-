                "discriminator": {
                  "propertyName": "tool",
                  "mapping": {
                    "text-summary": "#/components/schemas/TextSummary",
                    "youtube-summary": "#/components/schemas/YoutubeSummary",
                    "article-summary": "#/components/schemas/ArticleSummary",
                    "file-summary": "#/components/schemas/FileSummary",
                    "ocr": "#/components/schemas/OCR",
                    "image": "#/components/schemas/ImageGeneration",
                    "speech": "#/components/schemas/Speech",
                    "captions": "#/components/schemas/Captions",
                    "code": "#/components/schemas/Code",
                    "content": "#/components/schemas/Content",
                    "research": "#/components/schemas/Research",
                    "documents": "#/components/schemas/Intelligence",
                    "document-qa": "#/components/schemas/DocumentQA",
                    "url-qa": "#/components/schemas/URLQA",
                    "support": "#/components/schemas/Support"
                  }
                },
                "title": "Inputs"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Request-bound events: started, stage, warning, result, error. These are workflow observations, not model tokens.",
            "content": {
              "text/event-stream": {
                "schema": {
                  "$ref": "#/components/schemas/WorkflowEvent"
