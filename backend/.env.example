# Copy to backend/.env (ignored). Never paste credentials into chat or commit them.
TRACE_CLOUDFLARE_ACCOUNT_ID=
TRACE_CLOUDFLARE_API_TOKEN=
TRACE_OLLAMA_URL=http://ollama:11434
TRACE_ALLOWED_ORIGINS=http://localhost:3000
TRACE_PUBLIC_DEPLOYMENT=false
TRACE_TURNSTILE_SECRET=
TRACE_TURNSTILE_HOSTNAMES=localhost
# Generate once with: python -c 'import secrets; print(secrets.token_hex(32))'
TRACE_IP_HASH_SECRET=
# Only exact addresses of your reverse proxy. Untrusted forwarded headers are ignored.
TRACE_TRUSTED_PROXY_IPS=
